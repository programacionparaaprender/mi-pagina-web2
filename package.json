{
  "name": "mi-pagina-web2",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start2": "ng serve --port 8080",
    "github2": "ng deploy --base-href=https://programacionparaaprender.github.io/mi-pagina-web2/",
    "github3": "ng deploy",
    "github4": "ng build --configuration production && npx angular-cli-ghpages --dir=dist/mi-pagina-web2 --branch=gh-pages",
    "github5": "ng build --configuration production --base-href=/mi-pagina-web2/ && npx angular-cli-ghpages --dir=dist/mi-pagina-web2/browser --branch=gh-pages",
    "github": "ng build --configuration production --base-href=/mi-pagina-web2/ && npx angular-cli-ghpages --dir=dist/mi-pagina-web2 --branch=gh-pages",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "run:all": "node node_modules/@angular-architects/module-federation/src/server/mf-dev-server.js",
    "compodoc2": "npx compodoc -p tsconfig.app.json -d documentation --serve --open",
    "compodoc": "npx compodoc -p tsconfig.app.json --output src/docs --serve --open",
    "compodoc:build": "npx compodoc -p tsconfig.app.json -d documentation",
    "compodoc:material": "npx compodoc -p tsconfig.app.json -d documentation --theme material --serve --open",
    "compodoc:clean": "rm -rf documentation"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^21.0.1",
    "@angular/compiler": "^21.0.1",
    "@angular/core": "^21.0.1",
    "@angular/forms": "^21.0.1",
    "@angular/material": "^20.2.13",
    "@angular/platform-browser": "^21.0.1",
    "@angular/router": "^21.0.1",
    "@ngrx/effects": "^20.1.0",
    "@ngrx/store": "^20.1.0",
    "@ngrx/store-devtools": "^20.1.0",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "bootstrap": "^5.3.3",
    "jquery": "^3.7.1",
    "ngrx-store-localstorage": "^20.0.0",
    "popper.js": "^1.16.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-architects/module-federation": "^20.0.0",
    "@angular/build": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.1",
    "@auth0/auth0-angular": "^2.2.3",
    "@compodoc/compodoc": "^1.1.32",
    "@types/jasmine": "~5.1.0",
    "angular-cli-ghpages": "^2.0.3",
    "find-cache-dir": "^5.0.0",
    "gh-pages": "^6.3.0",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ngx-build-plus": "^20.0.0",
    "typescript": "~5.9.2"
  }
}